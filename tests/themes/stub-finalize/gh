#!/usr/bin/env python3
# Stub of gh for the test of finalize.sh in tests/themes/run.sh. $STATE holds releases.json, assets-<release id>.json and
# blob-<asset id> (the content of an asset); "gh attestation verify" succeeds; PATCH of a release is written to $STATE/patched.
import json, os, sys
st = os.environ['STATE']
args = sys.argv[1:]
if args[:2] == ['attestation', 'verify']:
    sys.exit(0)
assert args[0] == 'api', args
method, path, i = 'GET', None, 1
while i < len(args):
    if args[i] in ('-X',):
        method = args[i + 1]; i += 2
    elif args[i] in ('-H', '-F', '-f', '--jq'):
        i += 2
    elif args[i] == '--paginate':
        i += 1
    else:
        path = args[i]; i += 1
parts = path.split('?')[0].split('/')  # repos/o/r/releases[/...]
rest = parts[4:]
if method == 'PATCH':
    open(os.path.join(st, 'patched'), 'w').write(rest[0] + '\n')
elif not rest:
    sys.stdout.write(open(os.path.join(st, 'releases.json')).read())
elif rest[0] == 'assets':
    sys.stdout.buffer.write(open(os.path.join(st, 'blob-' + rest[1]), 'rb').read())
elif len(rest) == 2 and rest[1] == 'assets':
    sys.stdout.write(open(os.path.join(st, 'assets-%s.json' % rest[0])).read())
else:
    sys.exit('stub gh: unexpected ' + path)
